local function findPlayer(name)
	name = string.lower(name or "")

	if name == "" then
		return nil
	end

	for _,plr in ipairs(Players:GetPlayers()) do
		if string.lower(plr.Name) == name
		or string.find(string.lower(plr.Name),name,1,true) then
			return plr
		end
	end

	return nil
end

local function updateTargetRadar()
	if not radarTarget then
		if targetMarker then
			targetMarker:Destroy()
			targetMarker = nil
		end
		return
	end

	local target = findPlayer(targetName)

	if not target then
		if targetMarker then
			targetMarker:Destroy()
			targetMarker = nil
		end
		return
	end

	local char = target.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")

	if r then
		if not targetMarker then
			targetMarker =
				makeMarker(r,"🎯 "..target.Name)
		else
			targetMarker.Adornee = r
		end
	end
end

