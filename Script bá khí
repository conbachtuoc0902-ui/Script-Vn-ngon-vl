--==================================================
-- RADAR MARKERS
--==================================================

local markerFolder = Instance.new("Folder")
markerFolder.Name = "RadarMarkers"
markerFolder.Parent = workspace

local markers = {}

local function getPart(obj)

	if not obj or not obj.Parent then return nil end

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Tool") then
		local handle = obj:FindFirstChild("Handle",true)
		if handle and handle:IsA("BasePart") then
			return handle
		end
	end

	if obj:IsA("Model") then

		if obj.PrimaryPart then
			return obj.PrimaryPart
		end

		for _,v in ipairs(obj:GetDescendants()) do
			if v:IsA("BasePart") then
				return v
			end
		end
	end

	return nil
end

local function createMarker(obj,text)

	local part = getPart(obj)
	if not part then return end

	if markers[obj] then

		local marker = markers[obj]

		if marker.Parent then

			marker.Adornee = part

			local label = marker:FindFirstChild("Label")

			if label then
				label.Text = text
			end

			return
		end
	end

	local bill = Instance.new("BillboardGui")
	bill.Name = "RadarMarker"
	bill.Adornee = part
	bill.Size = UDim2.fromOffset(180,45)
	bill.StudsOffset = Vector3.new(0,3,0)
	bill.AlwaysOnTop = true
	bill.MaxDistance = RADAR_DISTANCE
	bill.Parent = markerFolder

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundColor3 = Color3.new(0,0,0)
	label.BackgroundTransparency = 0.25
	label.TextColor3 = Color3.fromRGB(255,255,0)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.Parent = bill

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,8)
	c.Parent = label

	markers[obj] = bill
end

local function removeMarker(obj)

	if markers[obj] then
		markers[obj]:Destroy()
		markers[obj] = nil
	end
end

--==================================================
-- ITEM DETECTION
--==================================================

local function lower(s)
	return string.lower(tostring(s))
end

local function nameLooksLikeItem(name)

	local n = lower(name)

	for _,word in ipairs(ITEM_KEYWORDS) do
		if string.find(n,word,1,true) then
			return true
		end
	end

	return false
end

local function insideItemFolder(obj)

	local p = obj.Parent

	while p and p ~= workspace do

		if ITEM_FOLDER_NAMES[p.Name] then
			return true
		end

		p = p.Parent
	end

	return false
end

local function isPlayerCharacter(obj)

	for _,plr in ipairs(Players:GetPlayers()) do

		if plr.Character
			and obj:IsDescendantOf(plr.Character) then

			return true
		end
	end

	return false
end

local function isItem(obj)

	if not obj or obj == workspace then
		return false
	end

	if isPlayerCharacter(obj) then
		return false
	end

	if CollectionService:HasTag(obj,"RadarItem") then
		return true
	end

	if obj:IsA("Tool") then
		return true
	end

	if obj:GetAttribute("IsItem") == true
		or obj:GetAttribute("Item") == true then
		return true
	end

	if insideItemFolder(obj) then

		if obj:IsA("Model")
			or obj:IsA("BasePart")
			or obj:IsA("Tool") then
			return true
		end
	end

	if (obj:IsA("Model") or obj:IsA("BasePart"))
		and nameLooksLikeItem(obj.Name) then
		return true
	end

	return false
end

local itemCache = {}

local function scanItems()

	table.clear(itemCache)

	for _,obj in ipairs(workspace:GetDescendants()) do

		if isItem(obj) then

			local part = getPart(obj)

			if part then
				itemCache[obj] = true
			end
		end
	end
end

