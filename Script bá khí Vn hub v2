local lastRescue = 0

RunService.Heartbeat:Connect(function()
	local h = getHumanoid()
	if not h then return end

	if h.MaxHealth > 0 then
		local percent = h.Health/h.MaxHealth*100

		status.Text =
			"❤️ HP: "..math.floor(h.Health)..
			" / "..math.floor(h.MaxHealth)..
			" | "..math.floor(percent).."%"

		if protection
		and AUTO_RESCUE
		and percent <= LOW_HP
		and safePosition
		and not rescueRunning
		and os.clock()-lastRescue > 3 then

			lastRescue = os.clock()
			flyToSafe()
		end
	end
end)

