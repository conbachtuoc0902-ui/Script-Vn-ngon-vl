--==================================================
-- RADAR UPDATE
--==================================================

local scanTimer = 0

RunService.Heartbeat:Connect(function(dt)

	if not root then return end

	scanTimer += dt

	if itemsRadar and scanTimer >= ITEM_SCAN_TIME then
		scanTimer = 0
		scanItems()
	end

	for obj in pairs(markers) do

		local need = false

		if itemsRadar and itemCache[obj] then
			need = true
		end

		if not obj.Parent then
			need = false
		end

		if not need then
			removeMarker(obj)
		end
	end

	if playersRadar then

		for _,plr in ipairs(Players:GetPlayers()) do

			if plr ~= LP and plr.Character then

				local pr =
					plr.Character:FindFirstChild("HumanoidRootPart")

				if pr then

					local distance =
						math.floor(
							(root.Position-pr.Position).Magnitude
						)

					createMarker(
						plr.Character,
						"👤 "..plr.DisplayName.." ["..distance.."m]"
					)
				end
			end
		end
	end

	if targetPlayer
		and targetPlayer ~= LP
		and targetPlayer.Character then

		local pr =
			targetPlayer.Character:FindFirstChild("HumanoidRootPart")

		if pr then

			local distance =
				math.floor(
					(root.Position-pr.Position).Magnitude
				)

			createMarker(
				targetPlayer.Character,
				"🎯 "..targetPlayer.DisplayName.." ["..distance.."m]"
			)
		end
	end

	if itemsRadar then

		for obj in pairs(itemCache) do

			local part = getPart(obj)

			if part then

				local distance =
					math.floor(
						(root.Position-part.Position).Magnitude
					)

				createMarker(
					obj,
					"📦 "..obj.Name.." ["..distance.."m]"
				)
			end
		end
	end
end)

