--==================================================
-- ITEM RADAR
--==================================================

local itemKeywords = {
	"item",
	"loot",
	"drop",
	"fruit",
	"chest",
	"weapon",
	"collect",
	"pickup",
	"reward",
	"coin",
	"gem",
	"tool"
}

local function looksLikeItem(obj)
	if CollectionService:HasTag(obj,"Item")
	or CollectionService:HasTag(obj,"Loot")
	or CollectionService:HasTag(obj,"Collectible") then
		return true
	end

	local name = string.lower(obj.Name)

	for _,keyword in ipairs(itemKeywords) do
		if string.find(name,keyword,1,true) then
			return true
		end
	end

	return false
end

local function getItemPart(obj)
	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then
		if obj.PrimaryPart then
			return obj.PrimaryPart
		end

		return obj:FindFirstChildWhichIsA("BasePart",true)
	end

	if obj:IsA("Tool") then
		return obj:FindFirstChild("Handle")
			or obj:FindFirstChildWhichIsA("BasePart",true)
	end

	return nil
end

local function updateItemRadar()
	if not radarItems then
		clearItemMarkers()
		return
	end

	clearItemMarkers()

	local found = {}

	for _,obj in ipairs(workspace:GetDescendants()) do
		if obj ~= getCharacter()
		and looksLikeItem(obj) then

			local part = getItemPart(obj)

			if part and not found[part] then
				found[part] = true

				local marker =
					makeMarker(part,"📦 "..obj.Name)

				if marker then
					table.insert(itemMarkers,marker)
				end
			end
		end
	end
end

radarItemButton.MouseButton1Click:Connect(function()
	radarItems = not radarItems

	radarItemButton.Text =
		radarItems
		and "📦 RADAR ITEM: ON"
		or "📦 RADAR ITEM: OFF"

	if radarItems then
		updateItemRadar()
	else
		clearItemMarkers()
	end
end)

