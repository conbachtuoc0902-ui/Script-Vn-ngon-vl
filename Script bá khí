local function findPlayer(text)

	text = string.lower(tostring(text))

	if text == "" then return nil end

	for _,plr in ipairs(Players:GetPlayers()) do
		if string.lower(plr.Name) == text
			or string.lower(plr.DisplayName) == text then
			return plr
		end
	end

	for _,plr in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(plr.Name),text,1,true)
			or string.find(string.lower(plr.DisplayName),text,1,true) then
			return plr
		end
	end

	return nil
end

searchButton.MouseButton1Click:Connect(function()

	targetPlayer = findPlayer(searchBox.Text)

	if targetPlayer then
		status.Text = "🎯 Đã tìm: "..targetPlayer.DisplayName
	else
		status.Text = "❌ Không tìm thấy người chơi"
	end
end)

local function stopTargetLock()

	targetLock = false
	targetButton.Text = "🎯 TARGET LOCK: OFF"

	if targetLockConnection then
		targetLockConnection:Disconnect()
		targetLockConnection = nil
	end
end

local function startTargetLock()

	if not targetPlayer then
		status.Text = "❌ Hãy tìm người chơi trước"
		return
	end

	targetLock = true
	targetButton.Text = "🎯 TARGET LOCK: ON"

	targetLockConnection = RunService.RenderStepped:Connect(function()

		if not targetLock then return end

		if not targetPlayer
			or not targetPlayer.Character then

			stopTargetLock()
			return
		end

		local targetRoot =
			targetPlayer.Character:FindFirstChild("HumanoidRootPart")

		local targetHum =
			targetPlayer.Character:FindFirstChildOfClass("Humanoid")

		if not targetRoot
			or not targetHum
			or targetHum.Health <= 0 then

			stopTargetLock()
			return
		end

		local camera = workspace.CurrentCamera

		if camera then
			camera.CFrame = CFrame.lookAt(
				camera.CFrame.Position,
				targetRoot.Position
			)
		end
	end)
end

