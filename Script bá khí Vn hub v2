--==================================================
-- FLIGHT
--==================================================

local upHeld = false
local downHeld = false

local function stopFlight()
	flying = false

	if flightConnection then
		flightConnection:Disconnect()
		flightConnection = nil
	end

	if flightBV then
		flightBV:Destroy()
		flightBV = nil
	end
end

local function startFlight()
	local r = getRoot()
	if not r then return end

	stopFlight()

	flying = true

	flightBV = Instance.new("BodyVelocity")
	flightBV.Name = "VietnamFlight"
	flightBV.MaxForce = Vector3.new(1e9,1e9,1e9)
	flightBV.P = 25000
	flightBV.Parent = r

	flightConnection = RunService.Heartbeat:Connect(function()
		if not flying or not flightBV then return end

		local h = getHumanoid()
		local rr = getRoot()

		if not h or not rr then
			stopFlight()
			return
		end

		local velocity = h.MoveDirection * flightSpeed

		if upHeld then
			velocity += Vector3.new(0,flightSpeed,0)
		end

		if downHeld then
			velocity += Vector3.new(0,-flightSpeed,0)
		end

		flightBV.Velocity = velocity
	end)
end

flyButton.MouseButton1Click:Connect(function()
	if flying then
		stopFlight()
		flyButton.Text = "✈️ BAY: OFF"
	else
		startFlight()
		flyButton.Text = "✈️ BAY: ON"
	end
end)

