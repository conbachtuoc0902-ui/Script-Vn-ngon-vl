--==================================================
-- BAY CỨU HỘ
--==================================================

local function flyToSafe()
	if rescueRunning then return end
	if not safePosition then
		rescueButton.Text = "⚠️ CHƯA LƯU"

		task.delay(1.5,function()
			if rescueButton.Parent then
				rescueButton.Text = "🛟 BAY CỨU HỘ"
			end
		end)

		return
	end

	local r = getRoot()
	if not r then return end

	rescueRunning = true

	local oldFlying = flying

	if flightBV then
		flightBV:Destroy()
		flightBV = nil
	end

	local bv = Instance.new("BodyVelocity")
	bv.Name = "SafeRescueFlight"
	bv.MaxForce = Vector3.new(1e9,1e9,1e9)
	bv.P = 30000
	bv.Parent = r

	local connection

	connection = RunService.Heartbeat:Connect(function()
		if not r.Parent then
			connection:Disconnect()
			bv:Destroy()
			rescueRunning = false
			return
		end

		local target = safePosition+Vector3.new(0,5,0)
		local offset = target-r.Position
		local distance = offset.Magnitude

		if distance <= 7 then
			bv.Velocity = Vector3.zero
			connection:Disconnect()
			bv:Destroy()

			rescueRunning = false

			if oldFlying then
				startFlight()
			end

			rescueButton.Text = "✅ ĐÃ VỀ AN TOÀN"

			task.delay(1.5,function()
				if rescueButton.Parent then
					rescueButton.Text = "🛟 BAY CỨU HỘ"
				end
			end)

			return
		end

		bv.Velocity =
			offset.Unit *
			math.min(140,math.max(60,distance*2))
	end)
end

rescueButton.MouseButton1Click:Connect(flyToSafe)

